# Copy to deploy/.env and adjust. docker compose reads it automatically.

# Key clients send in the X-API-KEY header (at least 16 characters).
API_KEY=change-me-to-a-long-random-key

# Shared secret for the X-Signature HMAC of callbacks (at least 32 characters).
CALLBACK_SIGNING_SECRET=change-me-to-a-long-random-signing-secret

# Allow callbacks to any private network address. Keep false unless receivers are internal;
# the demo does not need it, as demo-web is on the API's callback allow-list.
ALLOW_PRIVATE_CALLBACKS=false

# Model file, relative to the models volume (see deploy/models/models.txt).
WHISPERNET_MODEL=whispernet/ggml-large-v3-turbo-q5_0.bin
FASTERWHISPER_MODEL=fasterwhisper/large-v3-turbo
VOSK_MODEL=vosk/small-pl
# A Vosk model recognizes one language; state which.
VOSK_MODEL_LANGUAGE=pl
