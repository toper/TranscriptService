{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "EasyNetQ": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Jobs": "Data Source=/data/jobs.db",
    "RabbitMq": "host=rabbitmq"
  },
  "Api": {
    "StoragePath": "/data/audio",
    "MaxUploadBytes": 104857600,
    "MaxAudioDuration": "00:30:00",
    "ResultTtl": "00:15:00",
    "HighPriorityThreshold": "00:00:30",
    "CleanupInterval": "00:01:00"
  },
  "CallbackDelivery": {
    "AttemptTimeout": { "Timeout": "00:00:10" },
    "TotalRequestTimeout": { "Timeout": "00:02:00" },
    "Retry": {
      "MaxRetryAttempts": 5,
      "BackoffType": "Exponential",
      "UseJitter": true,
      "Delay": "00:00:02"
    }
  }
}
