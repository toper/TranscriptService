<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>Demo of the TranscriptService API: live microphone transcription in Blazor, results pushed over SignalR.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- The SDK infers this from .razor files, which the Docker restore layer (project files only)
         does not contain; without it blazor.web.js is missing from the published app. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TranscriptService.Demo.Web.Client\TranscriptService.Demo.Web.Client.csproj" />
    <ProjectReference Include="..\TranscriptService.ServiceDefaults\TranscriptService.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TranscriptService.Demo.Web.Tests" />
  </ItemGroup>

</Project>
